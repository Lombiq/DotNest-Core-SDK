<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Keep all the references below sorted alphabetically for easier merging into forks. -->

  <!-- Package versions for package groups -->
  <PropertyGroup>
    <CrestAppsVersion>2.0.0-rc.1</CrestAppsVersion>
    <LombiqBaseThemeVersion>11.0.1-alpha.6.osoe-925</LombiqBaseThemeVersion>
    <LombiqHostingMediaThemeVersion>9.0.1-alpha.2.nest-608</LombiqHostingMediaThemeVersion>
    <LombiqHostingTenantsVersion>10.0.0</LombiqHostingTenantsVersion>
    <OrchardCoreCommerceVersion>3.1.1-preview-377</OrchardCoreCommerceVersion>
    <OrchardCoreVersion>3.0.1</OrchardCoreVersion>
  </PropertyGroup>

  <!-- Orchard Core -->
  <ItemGroup>
    <PackageReference Include="OrchardCore" Version="$(OrchardCoreVersion)" />
    <PackageReference Include="OrchardCore.Application.Cms.Targets" Version="$(OrchardCoreVersion)" />
    <PackageReference Include="OrchardCore.ContentFields" Version="$(OrchardCoreVersion)" />
    <PackageReference Include="OrchardCore.Logging.NLog" Version="$(OrchardCoreVersion)" />
  </ItemGroup>

  <!-- Orchard Core Commerce -->
  <ItemGroup>
    <PackageReference Include="OrchardCore.Commerce" Version="$(OrchardCoreCommerceVersion)" />
    <PackageReference Include="OrchardCore.Commerce.ContentFields" Version="$(OrchardCoreCommerceVersion)" />
    <PackageReference Include="OrchardCore.Commerce.MoneyDataType" Version="$(OrchardCoreCommerceVersion)" />
    <PackageReference Include="OrchardCore.Commerce.Tax" Version="$(OrchardCoreCommerceVersion)" />
    <PackageReference Include="OrchardCore.Commerce.Tests.UI.Shortcuts" Version="$(OrchardCoreCommerceVersion)" />
  </ItemGroup>

  <!-- Third-party themes -->
  <ItemGroup>
    <PackageReference Include="TheBootstrapTheme" Version="3.0.1" />
    <PackageReference Include="TheClassLessTheme" Version="3.0.1" />
    <PackageReference Include="TheResumeTheme" Version="3.0.1" />
  </ItemGroup>

  <!-- Lombiq -->
  <ItemGroup>
    <PackageReference Include="Lombiq.Analyzers.OrchardCore" Version="6.0.0" />
    <PackageReference Include="Lombiq.BaseTheme" Version="$(LombiqBaseThemeVersion)" />
    <PackageReference Include="Lombiq.BaseTheme.Core" Version="12.0.0" />
    <PackageReference Include="Lombiq.BaseTheme.Native" Version="12.0.0" />
    <PackageReference Include="Lombiq.HelpfulExtensions" Version="12.0.0" />
    <PackageReference Include="Lombiq.HelpfulLibraries.OrchardCore" Version="13.0.0" />
    <PackageReference Include="Lombiq.Hosting.Azure.ApplicationInsights" Version="11.0.0" />
    <PackageReference Include="Lombiq.Hosting.MediaTheme" Version="$(LombiqHostingMediaThemeVersion)" />
    <PackageReference Include="Lombiq.Hosting.MediaTheme.Bridge" Version="$(LombiqHostingMediaThemeVersion)" />
    <PackageReference Include="Lombiq.Hosting.Tenants.Admin.Login" Version="$(LombiqHostingTenantsVersion)" />
    <PackageReference Include="Lombiq.Hosting.Tenants.FeaturesGuard" Version="$(LombiqHostingTenantsVersion)" />
    <PackageReference Include="Lombiq.Hosting.Tenants.IdleTenantManagement" Version="$(LombiqHostingTenantsVersion)" />
    <PackageReference Include="Lombiq.Hosting.Tenants.Management" Version="$(LombiqHostingTenantsVersion)" />
    <PackageReference Include="Lombiq.Privacy" Version="11.0.0" />
    <PackageReference Include="Lombiq.Tests.UI.AppExtensions" Version="15.0.0" />
    <PackageReference Include="Lombiq.Tests.UI.Shortcuts" Version="15.0.0" />
    <PackageReference Include="Lombiq.Marketing" Version="1.0.0" />
    <PackageReference Include="Lombiq.Marketing.Pirsch" Version="1.0.0" />
    <PackageReference Include="Lombiq.Marketing.UrlShortener" Version="1.0.0" />
    <PackageReference Include="Lombiq.UIKit" Version="11.0.0" />
    <PackageReference Include="Lombiq.UIKit.Widgets" Version="11.0.0" />
    <PackageReference Include="Lombiq.Walkthroughs" Version="4.0.0" />
  </ItemGroup>

  <!-- CrestApps -->
  <ItemGroup>
    <PackageReference Include="CrestApps.OrchardCore.AI" Version="$(CrestAppsVersion)" />
    <PackageReference Include="CrestApps.OrchardCore.AI.Agent" Version="$(CrestAppsVersion)" />
    <PackageReference Include="CrestApps.OrchardCore.AI.Chat" Version="$(CrestAppsVersion)" />
    <PackageReference Include="CrestApps.OrchardCore.AI.Mcp" Version="$(CrestAppsVersion)" />
    <PackageReference Include="CrestApps.OrchardCore.AzureAIInference" Version="$(CrestAppsVersion)" />
    <PackageReference Include="CrestApps.OrchardCore.Ollama" Version="$(CrestAppsVersion)" />
    <PackageReference Include="CrestApps.OrchardCore.OpenAI" Version="$(CrestAppsVersion)" />
    <PackageReference Include="CrestApps.OrchardCore.OpenAI.Azure" Version="$(CrestAppsVersion)" />
    <PackageReference Include="CrestApps.OrchardCore.Resources" Version="$(CrestAppsVersion)" />
    <PackageReference Include="CrestApps.OrchardCore.SignalR" Version="$(CrestAppsVersion)" />
  </ItemGroup>

  <!-- Project references -->
  <ItemGroup>
    <ProjectReference Include="..\Themes\Sample.Theme\Sample.Theme.csproj" />
  </ItemGroup>
  
  <!-- Security Updates - make sure to check if these are still necessary -->
  <ItemGroup>
    <!-- From OrchardCore.Application.Cms.Targets. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" NoWarn="NU1510" />
    <!-- Indirectly from CrestApps.Core.AI.Abstractions. -->
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.8.1" NoWarn="NU1510" />
  </ItemGroup>

</Project>
