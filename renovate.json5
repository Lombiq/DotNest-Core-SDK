{
    '$schema': 'https://docs.renovatebot.com/renovate-schema.json',
    'extends': [ 'github>Lombiq/renovate-config:default-orchard-core-superproject.json5' ],
    prBodyNotes: [
        '@Lombiq/dotnest-sites-renovate-notification-recipients',
    ],
    addLabels: [
        'no-jira-community-activity-issue',
    ],
    packageRules: [
        // The release of these themes are usually tied together.
        {
            groupName: 'Theme Packages',
            matchPackageNames: [
                'TheBootstrapTheme',
                'TheClassLessTheme',
                'TheResumeTheme',
            ],
        },
    ],
}
